rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userRole() {
      return isSignedIn() && exists(userDocPath())
        ? get(userDocPath()).data.role
        : null;
    }

    function isOwner() {
      return userRole() == 'owner';
    }

    function isAssistant() {
      return userRole() == 'assistant';
    }

    function isTeamMember() {
      return isOwner() || isAssistant();
    }

    // Ingredients
    match /ingredients/{docId} {
      allow read, write: if isTeamMember();
    }

    // Recipes
    match /recipes/{docId} {
      allow read, write: if isTeamMember();
    }

    // Sales
    match /sales/{docId} {
      allow read, write: if isTeamMember();
    }

    // Customers
    match /customers/{docId} {
      allow read, write: if isTeamMember();
    }

    // Stock movements
    match /stockMovements/{docId} {
      allow read, write: if isTeamMember();
    }

    // Supply expenses
    match /supplyExpenses/{docId} {
      allow read, write: if isTeamMember();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isTeamMember();
    }

    // Price history
    match /priceHistory/{docId} {
      allow read, write: if isTeamMember();
    }

    // Fixed costs
    match /fixedCostsByMonth/{docId} {
      allow read, write: if isTeamMember();
    }
  }
}
